# ============================================================
# onprem-llm-stack — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit secrets.
# ============================================================

# ── LiteLLM Gateway ─────────────────────────────────────────
# Host port the LiteLLM API listens on
LITELLM_PORT=4000

# Master key: all API requests must carry "Authorization: Bearer <key>".
# Generate a strong key for production: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-local-dev-change-me

# ── Open WebUI ───────────────────────────────────────────────
# Host port for the web interface
WEBUI_PORT=3000

# Session signing secret (any random string, kept server-side)
# Generate: openssl rand -hex 32
WEBUI_SECRET_KEY=changeme-local-dev

# ── Phase B: Virtual Keys + Audit Log ───────────────────────
# Set to "true" to store truncated (≤500 chars) prompt/response text in audit.db.
# Default false — privacy-minimization: log metadata only, not content.
AUDIT_LOG_CONTENT=false

# ── Phase C: Smoke Eval ─────────────────────────────────────
# API key used by smoke_eval.py to call the gateway.
# Needs access to both the generator model and the judge model.
# Falls back to LITELLM_MASTER_KEY if not set.
# Create a dedicated key: bash scripts/create_key.sh --user smoke-eval \
#   --models qwen3-32b,gemma4-31b --budget 5 --rpm 120
EVAL_API_KEY=

# LiteLLM API base URL (default: http://localhost:4000/v1)
EVAL_BASE_URL=http://localhost:4000/v1

# Generator model (the model under test)
EVAL_GENERATOR=qwen3-32b

# Judge model (must differ from EVAL_GENERATOR — independent scoring)
EVAL_JUDGE=gemma4-31b

# Pass rate threshold (0.0–1.0). Default 0.7 = 70% of questions must pass.
EVAL_PASS_THRESHOLD=0.7

# Per-request timeout in seconds (allow extra for Qwen3 thinking phase)
EVAL_TIMEOUT=120

# ── vLLM (prod profile only) ─────────────────────────────────
# Host path to the model cache directory (mounted read-only into the vLLM container)
VLLM_MODEL_CACHE_PATH=/mnt/data/models

# HuggingFace model ID or local path (relative to VLLM_MODEL_CACHE_PATH)
# VRAM budget on RTX 5090 (32 GB):
#   7B/8B  FP16  ≈ 16 GB — fits comfortably
#   13B    FP16  ≈ 26 GB — fits with limited context
#   32B    FP16  ≈ 64 GB — does NOT fit; use AWQ/GPTQ 4-bit quant (≈ 18 GB)
#                           e.g. "Qwen/Qwen2.5-32B-Instruct-AWQ"
# Note: model weights must be pre-downloaded before starting prod profile.
#       Do NOT start prod profile expecting an internet pull in production.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Maximum sequence length (tokens). Lower values reduce VRAM usage.
VLLM_MAX_MODEL_LEN=8192

# Tensor parallel degree — number of GPUs to shard across (1 for single GPU)
VLLM_TENSOR_PARALLEL_SIZE=1
