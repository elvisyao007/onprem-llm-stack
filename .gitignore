__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
venv/
.venv/
pip-log.txt
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Docker local state
.docker/

