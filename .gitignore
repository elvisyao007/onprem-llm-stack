# Environment — never commit secrets
.env

# Phase B: virtual key definitions (contain API keys) and audit database
configs/virtual_keys.yaml
data/audit.db

# Phase C: smoke-eval reports are generated artifacts, not source
eval/reports/*
!eval/reports/.gitkeep

# Invoice agent: write-back outputs are runtime artifacts, not source
payloads/invoice-agent/outputs/*
!payloads/invoice-agent/outputs/.gitkeep
.env.local
.env.*.local
*.env

